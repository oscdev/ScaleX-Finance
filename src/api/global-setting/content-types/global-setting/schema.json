      "required": true
    },
    "maintenanceModeIsEnabled": {
      "type": "boolean",
      "default": false
    },
    "retentionDays": {
      "type": "integer",
      "default": 30
    },
    "notificationsIsEnabled": {
      "type": "boolean",
      "default": true
    },
    "emailsIsEnabled": {
      "type": "boolean",
      "default": true
    }
  }
}