{
    "kind": "collectionType",
    "collectionName": "leads",
    "info": {
        "singularName": "lead",
        "pluralName": "leads",
        "displayName": "Lead",
        "description": "Submitted Lead Applications from Frontend"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "fullName": {
            "type": "string",
            "required": true
        },
        "email": {
            "type": "email",
            "required": true
        },
        "requiredAmount": {
            "type": "decimal",
            "required": true
        },
        "mobileNumber": {
            "type": "string",
            "required": true
        },
        "advisorReferralId": {
            "type": "string",
            "required": false
        },
        "selectedProduct": {
            "type": "string",
            "required": false
        },
        "panCard": {
            "type": "string"
        },
        "aadharCard": {
            "type": "string"
        },
        "propertyType": {
            "type": "string"
        },
        "propertyStatus": {
            "type": "string"
        },
        "propertyValue": {
            "type": "decimal"
        },
        "employmentType": {
            "type": "enumeration",
            "enum": [
                "Salaried",
                "Self Employed"
            ]
        },
        "leadType": {
            "type": "string"
        },
        "getEmailNotification": {
            "type": "boolean",
            "default": false
        },
        "pinCode": {
            "type": "string"
        },
        "status": {
            "type": "enumeration",
            "enum": [
                "NEW",
                "UNDER_PROCESS",
                "APPROVED",
                "REJECTED",
                "DISBURSED"
            ],
            "default": "NEW"
        },
        "remarks": {
            "type": "json"
        }
    }
}