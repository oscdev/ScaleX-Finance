{
    "kind": "collectionType",
    "collectionName": "zip_codes_to_lenders",
    "info": {
        "singularName": "zip-code",
        "pluralName": "zip-codes",
        "displayName": "Zip Codes",
        "description": "Serviceable pincodes per lender and loan type"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {
        "content-manager": {
            "visible": false
        },
        "content-type-builder": {
            "visible": false
        }
    },
    "attributes": {
        "lenderCode": {
            "type": "string",
            "required": true
        },
        "loanType": {
            "type": "enumeration",
            "enum": [
                "PL",
                "BL",
                "HL",
                "LAP"
            ],
            "required": true,
            "description": "Canonical product code: PL=Personal Loan, BL=Business Loan, HL=Home Loan, LAP=Loan Against Property. PL/BL PINCODE engines load rows for PL or BL only."
        },
        "zipCode": {
            "type": "integer"
        },
        "coversAllPincodes": {
            "type": "boolean",
            "default": false,
            "required": true
        },
        "isActive": {
            "type": "boolean",
            "default": true,
            "required": true
        }
    }
}
