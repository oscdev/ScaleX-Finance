{
    "kind": "collectionType",
    "collectionName": "advisors",
    "info": {
        "singularName": "advisor",
        "pluralName": "advisors",
        "displayName": "Advisor",
        "description": "Submitted Advisor Registration Applications"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "advisorId": {
            "type": "string",
            "unique": true
        },
        "fullName": {
            "type": "string",
            "required": true
        },
        "email": {
            "type": "email",
            "required": true,
            "unique": true
        },
        "phoneNumber": {
            "type": "string",
            "required": true
        },
        "password": {
            "type": "string",
            "required": true
        },
        "state": {
            "type": "string",
            "required": true
        },
        "district": {
            "type": "string",
            "required": true
        },
        "pinCode": {
            "type": "string",
            "required": true
        },
        "license": {
            "type": "string"
        },
        "panNumber": {
            "type": "string",
            "required": true
        },
        "specialization": {
            "type": "string",
            "required": true
        },
        "bankAccountNumber": {
            "type": "string",
            "required": true
        },
        "ifscCode": {
            "type": "string",
            "required": true
        },
        "bankName": {
            "type": "string",
            "required": true
        },
        "advisorStatus": {
            "type": "enumeration",
            "enum": [
                "Approved",
                "Disapproved"
            ],
            "default": "Disapproved"
        },
        "emailVerified": {
            "type": "boolean",
            "default": false
        },
        "earnings": {
            "type": "decimal",
            "default": 0
        }
    }
}