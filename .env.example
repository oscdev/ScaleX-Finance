HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Bureau PDF extraction — optional; auto-detects <project-root>/.venv/bin/python3
# PYTHON_PATH=/absolute/path/to/ScaleX-Finance-MVP/.venv/bin/python3

# Public Next.js URL — used by Strapi admin AI Match button (defaults to :3000 when admin is on :1337)
# FRONTEND_URL=http://localhost:3000

# Automation Testing /suite — started from Strapi bootstrap (`npm run start` or `npm run dev`).
# Next.js proxies /suite → http://127.0.0.1:$SUITE_PORT (default 4100). Restart Strapi after deploy so :4100 is bound.
# Missing Automation-Testing npm deps are installed on first Strapi boot. Set false to skip.
# SUITE_DASHBOARD=false
# SUITE_PORT=4100
# Frontend (optional, if the port is not 4100): SUITE_PROXY_ORIGIN=http://127.0.0.1:4100
